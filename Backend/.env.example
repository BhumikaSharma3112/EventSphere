# EventSphere Environment Variables Template
PORT=5000

# Set to true to bypass local MongoDB connection attempts and run in mock mode out-of-the-box
FORCE_MOCK=true

# MongoDB URI (Uncomment and edit to connect to a real MongoDB database)
# MONGO_URI=mongodb://127.0.0.1:27017/eventsphere

# JWT configuration
JWT_SECRET=eventsphere_secret_key_12345
